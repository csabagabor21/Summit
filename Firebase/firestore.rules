rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: heartbeats
// Document ID: napi "{install_id}_{day}" (pl. "550e8400-..._2026-09-15")
// vagy esemény "{install_id}_{day}_{esemény}_{epoch}" (pl. "..._login_1757960000").
// Író: maga az app, közvetlen Firestore REST-hívássl (nincs backend).
// Az összesítő install_id alapján deduplikál, a több doc nem dupláz.
// Fields:
//   - school_name: string (kötelező, 1-120 char; a KRÉTA-beli intézmény neve,
//                  ha nincs név, a nyers institut-kód — a szerver CODEBOOK-
//                  ból oldja fel; névből/kódból egyén nem beazonosít)
//   - institute_code: string (opcionális, 1-64 char; szerver-oldali feloldáshoz)
//   - install_id:  string (kötelező, véletlen UUID PONTOSAN UUID-alakban:
//                  8-4-4-4-12 hex — az app `UUID().uuidString`-et küld.
//                  Mivel a doc-ID-mintába is ez kerül, a szigorú alak
//                  zárja ki, hogy egy regex-metakarakteres install_id
//                  kitágítsa a `matches`-mintát.)
//   - day:         string (kötelező, yyyy-MM-dd formátum)
//   - app_version: string (opcionális, max 32 char)
//   - platform:    string (opcionális, max 32 char)
//   - createdAt:   timestamp (kötelező, max 10 perccel lehet régebbi)
//   - expiresAt:   timestamp (kötelező, = createdAt + 365 nap; TTL-mező)
//
// Collection: school_pins — név->koordináta térkép-pin szótár
// ({name, lon, lat, city?, source?}); a source a pin eredete
// (manual/nominatim/gazetteer), a city a geokódolt település neve.
// Csak az összesítő script írja/olvassa (service account),
// kliensnek sem írni, sem olvasni nem szabad.
//
// Collection: public — CSAK a `map` doc: összesített, név nélküli térkép-adat
// ({demo, schools, updated}); bárki olvashatja, senki nem írhatja (írást
// service account végez a scriptből). Más doc itt nem olvasható — a korábbi
// `ai_fallback` (közös Gemini-kulcs) megszűnt: a kulcs mostantól a
// Cloudflare worker `GEMINI_KEY` secretje, az app App Check-tokennel a
// worker `/ai/generate` végpontját hívja, kulcsot sosem lát.
//
// Collection: school_calendars — admin iskolai naptár-adatbázis.
// Document ID: normalizált institut-kód, kisbetűsen (pl. "siszc-mathiasz").
// Fields:
//   - calendarUrl: string (kötelező, 1-2000 char; a suli nyilvános naptár-
//                  linkje — Google-megosztólink vagy közvetlen ICS; az app
//                  a SchoolEventsStore.directDownloadURL-lel oldja fel)
//   - name: string (opcionális, max 120 char; az iskola megjelenő neve)
//   - updatedAt: timestamp (opcionális)
// Bárki olvashatja (belépéskor az app ez alapján tölti le az iskola
// naptárát), kliensből senki nem írhatja (írást admin végez konzolból —
// lásd school_calendars.seed.json). Kézi beállítás sosem íródik felül:
// ha az eszközön már van esemény vagy mentett link, az admin-kérés némán
// kihagy (SchoolCalendarDirectory).
//
// Collection: sync — LEGACY (v1), csak a még frissítetlen app-verziók miatt
// él. 2. fázisban (App Check-kényszerítéssel együtt) TÖRLENDŐ: az új app a
// `sync2`-t használja, és a v1 docot átmásolás után maga törli.
// 2. fázis lépései: (1) az `isValidSyncDoc()` függvény és a `match /sync/{id}`
// blokk törlése — onnantól a catch-all tilt; (2) ez a fejléc-szakasz törlése;
// (3) a rules-tesztben a `sync (legacy v1)` írás-tesztet assertFails-re
// fordítani; (4) deploy; (5) a maradék `sync` docok törlése konzolból.
// Blaze-mentes beállítás-szinkron (Spark).
// Document ID: SHA256-hex (64 kar.) az eszközön képzett kulcsból
// ("summit-sync-v1" + JWT sub/email + user jelmondat). A jelmondat sehova
// nem kerül fel, így az ID kitalálhatatlan: az ID ismerete a belépő
// ("unguessable capability"). Ezért: get igen, list nem.
// Fields:
//   - v: int (kötelező, == 1; sémaverzió)
//   - updatedAt: timestamp (kötelező, max 5 perccel lehet jövőbeli —
//                  óraelcsúszás-tűrés; utolsó írás nyer)
//   - theme: string (kötelező: system/light/dark)
//   - accentHex: int (kötelező, 0-0xFFFFFF)
//   - sizeKey: string (kötelező: system/large/extraLarge/
//              extraExtraLarge/extraExtraExtraLarge)
//   - skin: string (opcionális: summit/minecraft felület-skin;
//             hiánya = régi kliens, a helyi állapot marad)
//   - photo: string (kötelező, base64 jpeg ≤ 120 000 kar.; üres = nincs kép)
//   - rounding: string (kötelező, JSON tárgy→küszöb ≤ 16 000 kar.,
//                üres = nincs egyedi kerekítés)
//   - exempted: string (kötelező, JSON névtömb ≤ 8 000 kar., max 128;
//                "[]" = nincs felmentés)
//   - completedHw / completedEx: string (kötelező, JSON ID-tömbök
//                ≤ 12 000 kar., max 256-256; "[]" = nincs pipa)
//   - notifyEnabled / liveActivity: bool (kötelezők; az értesítések
//     egyetlen főkapcsolója — jegy, házi/dolgozat, hiányzás együtt)
//   - schoolEvents: string (opcionális, kompakt esemény-JSON ≤ 50 000 kar.,
//     "[]" = tudatos törlés; hiánya = régi kliens, a helyi állapot marad)
//   - schoolEventsShow: bool (opcionális; hiánya = régi kliens)
//   - schoolEventsURL: string (opcionális, mentett naptár-link ≤ 2000 kar.,
//     "" = nincs mentett link; hiánya = régi kliens, a helyi link marad)
//   - examRollover: bool (opcionális; dolgozat-pótlás kapcsoló,
//     hiánya = régi kliens, a helyi állapot marad)
//   - travelMode: string (opcionális, "yyyy-MM-dd/yyyy-MM-dd" ≤ 32 kar.,
//     "" = kikapcsolva; hiánya = régi kliens, a helyi állapot marad)
//   - ts_theme / ts_accentHex / ts_sizeKey / ts_photo / ts_rounding /
//     ts_exempted / ts_completedHw / ts_completedEx / ts_notifyEnabled /
//     ts_liveActivity /
//     ts_schoolEvents / ts_schoolEventsShow / ts_schoolEventsURL /
//     ts_customTasks / ts_examRollover / ts_travelMode: timestamp
//     (opcionálisak; mezőnkénti verzióbélyeg a delta-szinkronhoz —
//     hiányukban az updatedAt a helyettes. Régi kliensek nem írják.)
// OM, e-mail, token, jegy ebben a collectionben SOHA nem szerepelhet
// (a séma más mezőt nem enged).
//
// Collection: sync2 — végponttól végpontig titkosított beállítás-szinkron.
// Document ID: 64 hex kar. Az eszköz PBKDF2-vel (lassú kulcsképzés) a
// KRÉTA `sub` + a user jelmondata párosból egy mesterkulcsot képez, ebből
// HKDF-fel válik le a doc-ID és a titkosító kulcs. A szerver SOHA nem lát
// nyílt értéket: minden adatmező AES-GCM rejtjelszöveg (base64 string),
// így itt csak a típus és a méretplafon ellenőrizhető. Get igen, list nem.
// Fields:
//   - v: int (kötelező, == 2)
//   - updatedAt: timestamp (kötelező, max 5 perccel jövőbeli)
//   - theme, accentHex, sizeKey, skin, photo, rounding, exempted,
//     completedHw, completedEx, notifyEnabled, liveActivity, schoolEvents,
//     schoolEventsShow, schoolEventsURL, customTasks, cheatSheets,
//     metaAIKey, examRollover, travelMode, wrappedStars, hasWatch:
//     string (opcionális, rejtjelszöveg; plafon a v1-es nyílt plafon
//     UTF-8 (×2) és base64 (×4/3) ráhagyással + nonce/tag — lásd
//     `isValidSync2Doc`)
//   - ts_<mező>: timestamp (opcionális, mezőnkénti verzióbélyeg)
//
// ===============================================================

// ===============================================================
// Helper Functions
// ===============================================================
function hasOnlyAllowedFields(fields) {
  return request.resource.data.keys().hasOnly(fields);
}

function validInstituteCodeField() {
  return !('institute_code' in request.resource.data)
    || (request.resource.data.institute_code is string
      && request.resource.data.institute_code.size() >= 1
      && request.resource.data.institute_code.size() <= 64);
}

function isRecent(ts) {
  return ts is timestamp &&
    ts <= request.time &&
    ts > request.time - duration.value(10, 'm');
}

function isUuid(s) {
  return s is string
    && s.matches('^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$');
}

function isValidHeartbeat() {
  return hasOnlyAllowedFields(['school_name', 'institute_code', 'install_id', 'day', 'app_version', 'platform', 'createdAt', 'expiresAt'])
    && validInstituteCodeField()
    && request.resource.data.school_name is string
    && request.resource.data.school_name.size() >= 2
    && request.resource.data.school_name.size() <= 120
    && isUuid(request.resource.data.install_id)
    && request.resource.data.day is string
    && request.resource.data.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
    && (!('app_version' in request.resource.data) || (request.resource.data.app_version is string && request.resource.data.app_version.size() <= 32))
    && (!('platform' in request.resource.data) || (request.resource.data.platform is string && request.resource.data.platform.size() <= 32))
    && isRecent(request.resource.data.createdAt)
    && request.resource.data.expiresAt == request.resource.data.createdAt + duration.value(365, 'd');
}

function isValidSyncDoc() {
  return hasOnlyAllowedFields(['v', 'updatedAt', 'theme', 'accentHex', 'sizeKey', 'skin', 'photo',
      'rounding', 'exempted', 'completedHw', 'completedEx',
      'notifyEnabled', 'liveActivity',
      'schoolEvents', 'schoolEventsShow', 'schoolEventsURL', 'customTasks',
      'cheatSheets', 'metaAIKey', 'examRollover', 'travelMode', 'wrappedStars', 'hasWatch',
      'ts_theme', 'ts_accentHex', 'ts_sizeKey', 'ts_skin', 'ts_photo', 'ts_rounding',
      'ts_exempted', 'ts_completedHw', 'ts_completedEx', 'ts_notifyEnabled',
      'ts_liveActivity',
      'ts_schoolEvents', 'ts_schoolEventsShow', 'ts_schoolEventsURL', 'ts_customTasks',
      'ts_cheatSheets', 'ts_metaAIKey', 'ts_examRollover', 'ts_travelMode', 'ts_wrappedStars', 'ts_hasWatch'])
    && request.resource.data.v is int && request.resource.data.v == 1
    && request.resource.data.updatedAt is timestamp
    && request.resource.data.updatedAt <= request.time + duration.value(5, 'm')
    && request.resource.data.theme is string
    && request.resource.data.theme in ['system', 'light', 'dark']
    && request.resource.data.accentHex is int
    && request.resource.data.accentHex >= 0
    && request.resource.data.accentHex <= 16777215
    && request.resource.data.sizeKey is string
    && request.resource.data.sizeKey in ['system', 'large', 'extraLarge', 'extraExtraLarge', 'extraExtraExtraLarge']
    // Felület-skin: opcionális (régi kliens e nélkül is írhat),
    // 'summit' = gyári, 'minecraft' = modern blokk-stílus.
    && (!('skin' in request.resource.data) || (request.resource.data.skin is string
      && request.resource.data.skin in ['summit', 'minecraft']))
    && (!('ts_skin' in request.resource.data) || request.resource.data.ts_skin is timestamp)
    && request.resource.data.photo is string
    && request.resource.data.photo.size() <= 120000
    && request.resource.data.rounding is string
    && request.resource.data.rounding.size() <= 16000
    && request.resource.data.exempted is string
    && request.resource.data.exempted.size() <= 8000
    && request.resource.data.completedHw is string
    && request.resource.data.completedHw.size() <= 12000
    && request.resource.data.completedEx is string
    && request.resource.data.completedEx.size() <= 12000
    && request.resource.data.notifyEnabled is bool
    && request.resource.data.liveActivity is bool
    // Iskolai események: opcionálisak (régi kliens ezek nélkül is írhat),
    // de ha vannak: kompakt esemény-JSON (üres = tudatos törlés) + kapcsoló.
    && (!('schoolEvents' in request.resource.data) || (request.resource.data.schoolEvents is string
      && request.resource.data.schoolEvents.size() <= 50000))
    && (!('schoolEventsShow' in request.resource.data) || request.resource.data.schoolEventsShow is bool)
    && (!('ts_theme' in request.resource.data) || request.resource.data.ts_theme is timestamp)
    && (!('ts_accentHex' in request.resource.data) || request.resource.data.ts_accentHex is timestamp)
    && (!('ts_sizeKey' in request.resource.data) || request.resource.data.ts_sizeKey is timestamp)
    && (!('ts_photo' in request.resource.data) || request.resource.data.ts_photo is timestamp)
    && (!('ts_rounding' in request.resource.data) || request.resource.data.ts_rounding is timestamp)
    && (!('ts_exempted' in request.resource.data) || request.resource.data.ts_exempted is timestamp)
    && (!('ts_completedHw' in request.resource.data) || request.resource.data.ts_completedHw is timestamp)
    && (!('ts_completedEx' in request.resource.data) || request.resource.data.ts_completedEx is timestamp)
    && (!('ts_notifyEnabled' in request.resource.data) || request.resource.data.ts_notifyEnabled is timestamp)
    && (!('ts_liveActivity' in request.resource.data) || request.resource.data.ts_liveActivity is timestamp)
    && (!('ts_schoolEvents' in request.resource.data) || request.resource.data.ts_schoolEvents is timestamp)
    && (!('ts_schoolEventsShow' in request.resource.data) || request.resource.data.ts_schoolEventsShow is timestamp)
    && (!('schoolEventsURL' in request.resource.data) || (request.resource.data.schoolEventsURL is string
      && request.resource.data.schoolEventsURL.size() <= 2000))
    && (!('ts_schoolEventsURL' in request.resource.data) || request.resource.data.ts_schoolEventsURL is timestamp)
    // Saját feladatok/dolgozatok: opcionálisak (régi kliens ezek nélkül is
    // írhat), de ha vannak: kompakt JSON (üres = tudatos törlés).
    && (!('customTasks' in request.resource.data) || (request.resource.data.customTasks is string
      && request.resource.data.customTasks.size() <= 48000))
    && (!('ts_customTasks' in request.resource.data) || request.resource.data.ts_customTasks is timestamp)
    // Tanulójegyzet-lapok: opcionálisak (régi kliens ezek nélkül is
    // írhat), de ha vannak: kompakt JSON (üres = tudatos törlés).
    && (!('cheatSheets' in request.resource.data) || (request.resource.data.cheatSheets is string
      && request.resource.data.cheatSheets.size() <= 100000))
    && (!('ts_cheatSheets' in request.resource.data) || request.resource.data.ts_cheatSheets is timestamp)
    // Meta AI-kulcs: opcionális (régi kliens e nélkül is írhat), rövid
    // string, max 500 kar. (üres = a kulcs törlése az eszközön).
    && (!('metaAIKey' in request.resource.data) || (request.resource.data.metaAIKey is string
      && request.resource.data.metaAIKey.size() <= 500))
    && (!('ts_metaAIKey' in request.resource.data) || request.resource.data.ts_metaAIKey is timestamp)
    // Dolgozat-pótlás kapcsoló: opcionális (régi kliens e nélkül is írhat).
    && (!('examRollover' in request.resource.data) || request.resource.data.examRollover is bool)
    && (!('ts_examRollover' in request.resource.data) || request.resource.data.ts_examRollover is timestamp)
    // Utazás-intervallum: opcionális (régi kliens e nélkül is írhat),
    // "yyyy-MM-dd/yyyy-MM-dd" vagy üres (kikapcsolva), max 32 kar.
    && (!('travelMode' in request.resource.data) || (request.resource.data.travelMode is string
      && request.resource.data.travelMode.size() <= 32))
    && (!('ts_travelMode' in request.resource.data) || request.resource.data.ts_travelMode is timestamp)
    // Wrapped-csillagok: opcionális (régi kliens e nélkül is írhat),
    // hónap→képnév JSON, max 4000 kar. (üres "{}" = nincs csillag).
    && (!('wrappedStars' in request.resource.data) || (request.resource.data.wrappedStars is string
      && request.resource.data.wrappedStars.size() <= 4000))
    && (!('ts_wrappedStars' in request.resource.data) || request.resource.data.ts_wrappedStars is timestamp)
    // Órajelenlét: opcionális bool (van-e párosított óra az eszközön —
    // ebből tudja meg a Mac, hogy mutathatja a Watch tabot).
    && (!('hasWatch' in request.resource.data) || request.resource.data.hasWatch is bool)
    && (!('ts_hasWatch' in request.resource.data) || request.resource.data.ts_hasWatch is timestamp);
}

// --- sync2 (E2E-titkosított) ---------------------------------------
// Mezőnkénti rejtjelszöveg-plafon (karakter): a nyílt v1-plafon UTF-8-
// ráhagyással (a magyar ékezetes betű 2 bájt, ezért ×2), base64-gyel (×4/3)
// és 28 bájt nonce/tag-gel (a fotó eleve ASCII base64, ott ×4/3 elég);
// kis mezőknél egységes 200. Minden mező plafonon együtt ~840 KB, belefér
// a Firestore 1 MiB-os doc-korlátjába.
// A plafon literálként megy a hívásban (nem map-lookup), mert a rules
// kérésenként max 1000 kifejezést értékel ki — egy teljes doc így fér bele.
function sync2Fields() {
  return ['theme', 'accentHex', 'sizeKey', 'skin', 'photo', 'rounding',
    'exempted', 'completedHw', 'completedEx', 'notifyEnabled', 'liveActivity',
    'schoolEvents', 'schoolEventsShow', 'schoolEventsURL', 'customTasks',
    'cheatSheets', 'metaAIKey', 'examRollover', 'travelMode', 'wrappedStars',
    'hasWatch'];
}

function sync2TsFields() {
  return ['ts_theme', 'ts_accentHex', 'ts_sizeKey', 'ts_skin', 'ts_photo',
    'ts_rounding', 'ts_exempted', 'ts_completedHw', 'ts_completedEx',
    'ts_notifyEnabled', 'ts_liveActivity', 'ts_schoolEvents',
    'ts_schoolEventsShow', 'ts_schoolEventsURL', 'ts_customTasks',
    'ts_cheatSheets', 'ts_metaAIKey', 'ts_examRollover', 'ts_travelMode',
    'ts_wrappedStars', 'ts_hasWatch'];
}

// Egy opcionális rejtjel-mező: hiányzik, vagy plafon alatti string.
function encOk(d, k, max) {
  return !(k in d) || (d[k] is string && d[k].size() <= max);
}

// Egy opcionális bélyeg: hiányzik, vagy timestamp.
function tsOk(d, k) {
  return !(k in d) || d[k] is timestamp;
}

function isValidSync2Doc() {
  let d = request.resource.data;
  return d.keys().hasOnly(['v', 'updatedAt'].concat(sync2Fields()).concat(sync2TsFields()))
    && d.v is int && d.v == 2
    && d.updatedAt is timestamp
    && d.updatedAt <= request.time + duration.value(5, 'm')
    && encOk(d, 'theme', 200) && encOk(d, 'accentHex', 200) && encOk(d, 'sizeKey', 200)
    && encOk(d, 'skin', 200) && encOk(d, 'photo', 160100) && encOk(d, 'rounding', 42800)
    && encOk(d, 'exempted', 21400) && encOk(d, 'completedHw', 32100) && encOk(d, 'completedEx', 32100)
    && encOk(d, 'notifyEnabled', 200) && encOk(d, 'liveActivity', 200)
    && encOk(d, 'schoolEvents', 133400) && encOk(d, 'schoolEventsShow', 200)
    && encOk(d, 'schoolEventsURL', 5400) && encOk(d, 'customTasks', 128100)
    && encOk(d, 'cheatSheets', 266800) && encOk(d, 'metaAIKey', 1400)
    && encOk(d, 'examRollover', 200) && encOk(d, 'travelMode', 200)
    && encOk(d, 'wrappedStars', 10800) && encOk(d, 'hasWatch', 200)
    && tsOk(d, 'ts_theme') && tsOk(d, 'ts_accentHex') && tsOk(d, 'ts_sizeKey')
    && tsOk(d, 'ts_skin') && tsOk(d, 'ts_photo') && tsOk(d, 'ts_rounding')
    && tsOk(d, 'ts_exempted') && tsOk(d, 'ts_completedHw')
    && tsOk(d, 'ts_completedEx') && tsOk(d, 'ts_notifyEnabled')
    && tsOk(d, 'ts_liveActivity') && tsOk(d, 'ts_schoolEvents')
    && tsOk(d, 'ts_schoolEventsShow') && tsOk(d, 'ts_schoolEventsURL')
    && tsOk(d, 'ts_customTasks') && tsOk(d, 'ts_cheatSheets')
    && tsOk(d, 'ts_metaAIKey') && tsOk(d, 'ts_examRollover')
    && tsOk(d, 'ts_travelMode') && tsOk(d, 'ts_wrappedStars')
    && tsOk(d, 'ts_hasWatch');
}

service cloud.firestore {
  match /databases/{database}/documents {

    match /heartbeats/{doc} {
      // Csak létrehozás, szigorú sémával; az ID-nek egyeznie kell a tartalommal:
      // napi doc vagy esemény-doc ({install}_{nap}_{esemény}_{epoch}).
      // A mintába kerülő install_id-t az isValidHeartbeat UUID-alakra
      // kényszeríti (a day is szigorú yyyy-MM-dd), így nincs benne
      // regex-metakarakter — a matches full-match, nem tágítható.
      allow create: if isValidHeartbeat()
        && (doc == request.resource.data.install_id + '_' + request.resource.data.day
          || doc.matches(request.resource.data.install_id + '_' + request.resource.data.day + '_[a-z]{1,32}_[0-9]{9,11}'));
      allow read, update, delete: if false;
    }

    match /school_pins/{pin} {
      allow read, write: if false;
    }

    match /public/{doc} {
      // Csak a térkép publikus. Minden más doc (pl. a megszűnt
      // ai_fallback) olvashatatlan, akkor is, ha valaha létrejönne.
      allow read: if doc == 'map';
      allow write: if false;
    }

    match /school_calendars/{code} {
      // Publikus olvasás: belépéskor az app institut-kód alapján lehúzza
      // az iskola naptár-linkjét. Írás kliensből tiltott (admin-konzol).
      allow read: if true;
      allow write: if false;
    }

    // LEGACY (v1) — 2. fázisban TÖRLENDŐ (lásd a fejléc sync-szakaszát).
    match /sync/{id} {
      // ID: 64 hex kar. (SHA256). Get: az ID ismerete a belépő.
      // Listázni (gyűjteni) senki nem tud — nincs enumerálás.
      allow get: if id.matches('^[0-9a-f]{64}$');
      allow list: if false;
      allow create, update: if id.matches('^[0-9a-f]{64}$') && isValidSyncDoc();
      allow delete: if id.matches('^[0-9a-f]{64}$');
    }

    match /sync2/{id} {
      // ID: 64 hex kar. (PBKDF2→HKDF az eszközön). Get: az ID ismerete a
      // belépő; listázni (gyűjteni) senki nem tud. Az értékek rejtjelezettek:
      // a jelmondat nélkül a tartalom akkor sem olvasható, ha a doc
      // (pl. egy kiszivárgott service-account kulccsal) kikerül.
      allow get: if id.matches('^[0-9a-f]{64}$');
      allow list: if false;
      allow create, update: if id.matches('^[0-9a-f]{64}$') && isValidSync2Doc();
      allow delete: if id.matches('^[0-9a-f]{64}$');
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

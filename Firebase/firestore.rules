rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: heartbeats
// Document ID: napi "{install_id}_{day}" (pl. "550e8400-..._2026-09-15")
// vagy esemény "{install_id}_{day}_{esemény}_{epoch}" (pl. "..._login_1757960000").
// Író: maga az app, közvetlen Firestore REST-hívássl (nincs backend).
// Az összesítő install_id alapján deduplikál, a több doc nem dupláz.
// Fields:
//   - school_name: string (kötelező, 1-120 char; a KRÉTA-beli intézmény neve,
//                  ha nincs név, a nyers institut-kód — a szerver CODEBOOK-
//                  ból oldja fel; névből/kódból egyén nem beazonosít)
//   - institute_code: string (opcionális, 1-64 char; szerver-oldali feloldáshoz)
//   - install_id:  string (kötelező, 8-64 char, véletlen UUID)
//   - day:         string (kötelező, yyyy-MM-dd formátum)
//   - app_version: string (opcionális, max 32 char)
//   - platform:    string (opcionális, max 32 char)
//   - createdAt:   timestamp (kötelező, max 10 perccel lehet régebbi)
//   - expiresAt:   timestamp (kötelező, = createdAt + 365 nap; TTL-mező)
//
// Collection: school_pins — név->koordináta térkép-pin szótár
// ({name, lon, lat, city?, source?}); a source a pin eredete
// (manual/nominatim/gazetteer), a city a geokódolt település neve.
// Csak az összesítő script írja/olvassa (service account),
// kliensnek sem írni, sem olvasni nem szabad.
//
// Collection: public — összesített, név nélküli térkép-adat ({demo, schools,
// updated}); bárki olvashatja, senki nem írhatja (írást service account
// végez konzolból/scriptből).
//
// ===============================================================

// ===============================================================
// Helper Functions
// ===============================================================
function hasOnlyAllowedFields(fields) {
  return request.resource.data.keys().hasOnly(fields);
}

function validInstituteCodeField() {
  return !('institute_code' in request.resource.data)
    || (request.resource.data.institute_code is string
      && request.resource.data.institute_code.size() >= 1
      && request.resource.data.institute_code.size() <= 64);
}

function isRecent(ts) {
  return ts is timestamp &&
    ts <= request.time &&
    ts > request.time - duration.value(10, 'm');
}

function isValidHeartbeat() {
  return hasOnlyAllowedFields(['school_name', 'institute_code', 'install_id', 'day', 'app_version', 'platform', 'createdAt', 'expiresAt'])
    && validInstituteCodeField()
    && request.resource.data.school_name is string
    && request.resource.data.school_name.size() >= 2
    && request.resource.data.school_name.size() <= 120
    && request.resource.data.install_id is string
    && request.resource.data.install_id.size() >= 8
    && request.resource.data.install_id.size() <= 64
    && request.resource.data.day is string
    && request.resource.data.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
    && (!('app_version' in request.resource.data) || (request.resource.data.app_version is string && request.resource.data.app_version.size() <= 32))
    && (!('platform' in request.resource.data) || (request.resource.data.platform is string && request.resource.data.platform.size() <= 32))
    && isRecent(request.resource.data.createdAt)
    && request.resource.data.expiresAt == request.resource.data.createdAt + duration.value(365, 'd');
}

service cloud.firestore {
  match /databases/{database}/documents {

    match /heartbeats/{doc} {
      // Csak létrehozás, szigorú sémával; az ID-nek egyeznie kell a tartalommal:
      // napi doc vagy esemény-doc ({install}_{nap}_{esemény}_{epoch}).
      // Az alap UUID+hex+kötőjel, így regex-biztos a matches-ben (full-match).
      allow create: if (doc == request.resource.data.install_id + '_' + request.resource.data.day
          || doc.matches(request.resource.data.install_id + '_' + request.resource.data.day + '_[a-z]+_[0-9]+'))
        && isValidHeartbeat();
      allow read, update, delete: if false;
    }

    match /school_pins/{pin} {
      allow read, write: if false;
    }

    match /public/{doc} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
